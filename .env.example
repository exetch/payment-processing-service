# Скопируйте в .env и при необходимости поменяйте значения.
# docker-compose читает этот файл автоматически (см. README).

# Статический API-ключ для заголовка X-API-Key
API_KEY=supersecret-dev-key

# PostgreSQL (значения используются и контейнером postgres, и приложением)
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

LOG_LEVEL=INFO

# Эмулятор платёжного шлюза
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9

# Webhook-уведомления
WEBHOOK_TIMEOUT_SECONDS=5
# Секрет подписи уведомлений (заголовок X-Webhook-Signature)
WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret
# Хосты через запятую, которым разрешено быть во внутренней сети (защита от SSRF).
# Пусто = запрещены все приватные адреса. В compose добавлен webhook-sink для демо.
WEBHOOK_ALLOWED_HOSTS=

# Retry-политика consumer'а: 1 первичная попытка + N ретраев (2s, 4s, 8s ...)
CONSUMER_MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2

# Outbox relay
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100
# Backoff для строки, которую не удалось опубликовать
OUTBOX_RETRY_BASE_DELAY_SECONDS=1
OUTBOX_RETRY_MAX_DELAY_SECONDS=60
